#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python_bin="$project_dir/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  printf '%s\n' 'Ambiente Python ausente. Execute: python3 -m venv .venv' '.venv/bin/python -m pip install -r requirements.txt' >&2
  exit 1
fi
exec "$python_bin" "$project_dir/caderno.py" "$@"
